<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>{{ titre }} — {{ reference }}</title>
{# Dates du document = JOURNÉE COMPTABLE : jamais l'horloge (le moteur y mettrait l'heure du poste). #}
<meta name="dcterms.created" content="{{ journee_iso }}">
<meta name="dcterms.modified" content="{{ journee_iso }}">
<style>{{ css | safe }}</style>
</head>
<body>
{% if brouillon %}<div class="pied-brouillon">{{ libelles.brouillon_etat }}</div>{% endif %}
{% for exemplaire in exemplaires %}
{% if not loop.first %}<div class="trait">{{ libelles.decouper_ici }}</div>{% endif %}
<section class="exemplaire">
  {% if brouillon %}<p class="bandeau-brouillon">{{ libelles.brouillon_etat }}</p>{% endif %}
  {% if institution.provisoire %}<p class="bandeau-provisoire">{{ libelles.bandeau_provisoire }}</p>{% endif %}
  {# Mises en page en TABLEAUX (jamais de flottants) : WeasyPrint calcule mal la hauteur d'un bloc
     de flottants, et l'exemplaire suivant remontait sur le trait de découpe. #}
  <table class="duo entete">
    <tr>
      <td class="gauche">
        <h1>{{ institution.nom or libelles.institution_absente }}</h1>
        {% if institution.adresse %}<p>{{ institution.adresse }}</p>{% endif %}
        {% if institution.telephone %}<p>{{ libelles.telephone }} {{ institution.telephone }}</p>{% endif %}
        {% if institution.numero_agrement %}<p>{{ libelles.agrement }} {{ institution.numero_agrement }}</p>{% endif %}
      </td>
      <td class="droite">
        <p>{{ libelles.agence }} {{ agence.nom }} ({{ agence.code }})</p>
        <p><strong>{{ libelles.journee_comptable }} {{ journee_affichee }}</strong></p>
      </td>
    </tr>
  </table>

  <table class="duo titre">
    <tr>
      <td class="gauche"><h2>{{ titre }}</h2></td>
      <td class="droite reference">{{ reference }}</td>
    </tr>
  </table>
  {% if exemplaire %}<p class="exemplaire-nom">{{ exemplaire }}{% if duplicata %} — {{ libelles.duplicata }}{% endif %}</p>{% endif %}

  {% block corps scoped %}{% endblock %}

  {% block signatures scoped %}
  <table class="duo signatures">
    <tr>
      <td class="zone">
        <p>{{ libelles.signature_client_obligatoire if signature_client_requise else libelles.signature_client_facultative }}</p>
        <div class="ligne"></div>
      </td>
      <td class="espace"></td>
      <td class="zone">
        <p>{{ libelles.signature_caissier }}</p>
        <div class="ligne"></div>
      </td>
    </tr>
  </table>
  {% endblock %}
</section>
{% endfor %}
</body>
</html>
