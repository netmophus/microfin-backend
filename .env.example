ENV=dev
DATABASE_URL=postgresql+psycopg://mifin:mifin@localhost:5432/mifin
REDIS_URL=redis://localhost:6379/0

# TEST_DATABASE_URL — base de test JETABLE (chantier P1ter), lue par conftest.py (variable
# d'environnement OS réelle, PAS depuis ce fichier .env : pydantic-settings charge .env dans
# Settings, jamais dans os.environ — exportez-la dans le shell/CI si vous voulez changer le
# défaut). Non définie, la suite utilise mifin_test sur le même cluster que DATABASE_URL.
# DROP puis CREATE à chaque session de test : jamais la base de dev, jamais de données réelles.
# TEST_DATABASE_URL=postgresql+psycopg://mifin:mifin@localhost:5435/mifin_test

# Clé de signature des jetons JWT. Aucune valeur ici : ce fichier est public.
# Générer avec : openssl rand -hex 32
# Minimum 32 caractères, sinon l'application refuse de démarrer (RFC 7518 §3.2).
# CHAQUE installation IMF doit avoir SON secret : deux installations qui partagent
# cette clé rendent leurs jetons interchangeables d'une IMF à l'autre.
JWT_SECRET=à-générer-avec-openssl-rand-hex-32